---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.title}>
  <article class="post">
    <p><a class="back-link" href="/blog/">← 返回文章列表</a></p>
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
      · {post.data.category}
      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
