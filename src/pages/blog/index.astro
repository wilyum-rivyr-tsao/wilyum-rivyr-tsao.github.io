---
import Base from '../../layouts/Base.astro';
import { UI } from '../../consts';
import { getCollection } from 'astro:content';

// 平铺文章列表：无日期/分类概念，按标题排序
const posts = (await getCollection('blog'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

// 标签聚合：按出现次数降序（次数相同按标签名字典序）
const tagCount = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title={UI.blogPage.title.zh} description={UI.blogPage.description.zh}>
  <h1 class="page-title">
    <span class="lang-zh">{UI.blogPage.title.zh}</span><span class="lang-en">{UI.blogPage.title.en}</span>
  </h1>
  <div class="tag-filter">
    <span class="filter-label">
      <span class="lang-zh">{UI.blogPage.filterLabel.zh}</span><span class="lang-en">{UI.blogPage.filterLabel.en}</span>
    </span>
    <button class="filter-btn" data-tag="" type="button">
      <span class="lang-zh">{UI.blogPage.filterAll.zh}</span><span class="lang-en">{UI.blogPage.filterAll.en}</span>
    </button>
    {tags.map(([tag, n]) => (
      <button class="filter-btn" data-tag={tag} type="button">{tag}<sup>{n}</sup></button>
    ))}
  </div>
  <div id="post-list">
    {posts.map((p) => (
      <div class="post-row" data-tags={p.data.tags.join('|')}>
        <a href={`/blog/${p.id}/`}>{p.data.title}</a>
        <span class="post-tags">
          {p.data.tags.map((t) => <span class="tag">{t}</span>)}
        </span>
        <span class="lang-badge">{p.data.lang === 'zh' ? '中文' : 'EN'}</span>
      </div>
    ))}
  </div>
  <script is:inline>
    // 标签筛选：纯前端显隐；支持 ?tag=xxx 直达（文章详情页的 tag 链接带参回来）
    (function () {
      var btns = document.querySelectorAll('.tag-filter .filter-btn');
      var rows = document.querySelectorAll('#post-list .post-row');
      function apply(tag) {
        btns.forEach(function (b) { b.classList.toggle('active', b.dataset.tag === tag); });
        rows.forEach(function (r) {
          r.style.display = !tag || (r.dataset.tags || '').split('|').indexOf(tag) !== -1 ? '' : 'none';
        });
        var url = new URL(window.location.href);
        if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
        history.replaceState(null, '', url);
      }
      btns.forEach(function (b) {
        b.addEventListener('click', function () { apply(b.dataset.tag || ''); });
      });
      var initial = new URLSearchParams(window.location.search).get('tag') || '';
      apply(initial);
    })();
  </script>
</Base>
