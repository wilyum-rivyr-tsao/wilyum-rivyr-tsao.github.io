---
import Base from '../../layouts/Base.astro';
import { UI } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
posts.forEach((p) => {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
});
const years = [...byYear.keys()].sort((a, b) => b - a);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title={UI.blogPage.title.zh} description={UI.blogPage.description.zh}>
  <h1 class="page-title">
    <span class="lang-zh">{UI.blogPage.title.zh}</span><span class="lang-en">{UI.blogPage.title.en}</span>
  </h1>
  {years.map((y) => (
    <section class="year-group">
      <h2>{y}</h2>
      {byYear.get(y)!.map((p) => (
        <div class="post-row">
          <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          <span class="lang-badge">{p.data.lang === 'zh' ? '中文' : 'EN'}</span>
          <span class="cat">{p.data.category}</span>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        </div>
      ))}
    </section>
  ))}
</Base>
